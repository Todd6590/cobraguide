{
  "name": "Beneficiary",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "ssn_last4": {
      "type": "string",
      "description": "Last 4 digits of SSN"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "Reference to Client entity"
    },
    "client_name": {
      "type": "string",
      "description": "Client company name for display"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "employee",
        "spouse",
        "dependent"
      ],
      "default": "employee"
    },
    "coverage_type": {
      "type": "string",
      "enum": [
        "medical",
        "dental",
        "vision",
        "medical_dental",
        "medical_vision",
        "medical_dental_vision",
        "dental_vision"
      ]
    },
    "insurance_carriers": {
      "type": "string",
      "description": "Current insurance carrier(s) for the coverage lines indicated"
    },
    "cobra_status": {
      "type": "string",
      "enum": [
        "pending_event",
        "notice_sent",
        "elected",
        "declined",
        "active",
        "terminated",
        "expired"
      ],
      "default": "pending_event"
    },
    "cobra_start_date": {
      "type": "string",
      "format": "date"
    },
    "cobra_end_date": {
      "type": "string",
      "format": "date"
    },
    "monthly_premium": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "client_id"
  ]
}