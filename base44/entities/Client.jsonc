{
  "name": "Client",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Name of the client company"
    },
    "ein": {
      "type": "string",
      "description": "Employer Identification Number"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact person"
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Primary contact phone"
    },
    "address": {
      "type": "string",
      "description": "Company address"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "medical",
        "dental",
        "vision",
        "medical_dental",
        "medical_vision",
        "medical_dental_vision",
        "dental_vision"
      ],
      "description": "Types of coverage offered"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "onboarding"
      ],
      "default": "active"
    },
    "employee_count": {
      "type": "number",
      "description": "Number of employees"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_name"
  ]
}