{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user this plan belongs to"
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "professional",
        "agency"
      ],
      "default": "trial",
      "description": "Subscription tier"
    },
    "client_limit": {
      "type": "number",
      "description": "Max number of clients allowed (0 = unlimited)"
    },
    "trial_start_date": {
      "type": "string",
      "format": "date",
      "description": "Date the trial started"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID after payment"
    },
    "is_study_group": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was a StudyGroup promo trial"
    },
    "study_group_trial_start": {
      "type": "string",
      "format": "date",
      "description": "Date the StudyGroup 7-day trial started"
    },
    "study_group_trial_end": {
      "type": "string",
      "format": "date",
      "description": "Date the StudyGroup trial ends (day 7)"
    },
    "study_group_expired": {
      "type": "boolean",
      "default": false,
      "description": "Whether the StudyGroup trial has expired and user needs to pick a plan"
    },
    "day6_email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the day-6 reminder email has been sent"
    }
  },
  "required": [
    "user_email",
    "plan_tier"
  ]
}