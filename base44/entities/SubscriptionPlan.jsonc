{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user this plan belongs to"
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "professional",
        "agency"
      ],
      "default": "trial",
      "description": "Subscription tier"
    },
    "client_limit": {
      "type": "number",
      "description": "Max number of clients allowed (0 = unlimited)"
    },
    "trial_start_date": {
      "type": "string",
      "format": "date",
      "description": "Date the trial started"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID after payment"
    }
  },
  "required": [
    "user_email",
    "plan_tier"
  ]
}